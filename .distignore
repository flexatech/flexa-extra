# Files and folders excluded from the distributed plugin zip.
# Only the compiled admin bundle in assets/dist/ is shipped. The TypeScript
# source and build tooling under apps/ are build-time only (never loaded at
# runtime) and are published on GitHub instead, so the whole folder is excluded.

/.git
/.github
/.gitignore
/.distignore
/release.sh
/dist
/node_modules
/apps
/includes/Register/RegisterDev.php
/tests
/bin
/phpstan
/phpstan.neon
/phpstan-integration.xml.dist
/phpunit.xml.dist
/phpunit-integration.xml.dist
/.phpunit.result.cache
/.phpunit.cache

# OS cruft (match at any depth — no leading slash)
.DS_Store
Thumbs.db
/composer.json
/composer.lock
/vendor
/docs
/.editorconfig

# Markdown docs are not shipped in the plugin (readme.txt is the WP.org readme).
*.md
